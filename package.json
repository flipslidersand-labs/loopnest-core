{
  "name": "loopnest-core",
  "version": "0.1.0",
  "private": true,
  "description": "LoopNest Core / OmniTrade Data Platform",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "migrate": "bash infra/migrations/run.sh",
    "test:integration": "bash tests/integration/run-all.sh",
    "db:reset": "docker compose down -v && docker compose up -d"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "js-yaml": "^4.1.1",
    "pg": "^8.21.0"
  }
}
