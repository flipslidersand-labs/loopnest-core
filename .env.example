# LoopNest Core — environment variables
# Copy this file to .env and fill in the required values:
#   cp .env.example .env

# ── Server ────────────────────────────────────────────────────────────────────
# TCP port the API server listens on
PORT=3000
# Runtime environment (development | production | test)
NODE_ENV=development

# ── Authentication ────────────────────────────────────────────────────────────
# Secret used to sign and verify JWT tokens — use a long random string in production
JWT_SECRET=change_me_in_production

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Full connection URL (takes precedence over individual POSTGRES_* vars if set)
DATABASE_URL=postgresql://loopnest:loopnest_dev_password@localhost:5432/omni_local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=loopnest
POSTGRES_PASSWORD=loopnest_dev_password
POSTGRES_DB=omni_local

# ── Redis / Valkey ────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── EventWorker ───────────────────────────────────────────────────────────────
# Outbox polling interval in milliseconds (default: 5000)
EVENT_WORKER_INTERVAL_MS=5000
# Maximum delivery attempts before an event is dead-lettered (default: 5)
OUTBOX_MAX_RETRIES=5
# How often to scan for overdue invoices in milliseconds (default: 3600000 = 1h)
OVERDUE_SCAN_INTERVAL_MS=3600000
# How often to scan for expired quotes in milliseconds (default: 3600000 = 1h)
EXPIRY_SCAN_INTERVAL_MS=3600000
# How often to scan for recurring contracts due for billing (default: 3600000 = 1h)
RECURRING_SCAN_INTERVAL_MS=3600000

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Max requests per window for the global bucket (default: 300)
RATE_LIMIT_GLOBAL_MAX=300
# Max requests per window for workflow/payment endpoints (default: 60)
RATE_LIMIT_WORKFLOW_MAX=60
# Rate limit window in seconds (default: 60)
RATE_LIMIT_WINDOW_SECONDS=60

# ── External integrations ─────────────────────────────────────────────────────
# Base URL of the mock accounting API used for invoice export
MOCK_ACCOUNTING_API_URL=http://localhost:3991
