{
  "name": "@loopnest/bizcore-db",
  "version": "0.1.0",
  "private": true,
  "description": "LoopNest Core DB clients integration",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prisma": "prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "type-check": "tsc --noEmit",
    "test:repos": "node --loader ts-node/esm src/test-repositories.ts"
  },
  "dependencies": {
    "pg": "^8.13.0",
    "pg-cursor": "^2.22.0",
    "kysely": "^0.27.3",
    "ioredis": "^5.4.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@prisma/client": "^5.11.0",
    "@types/pg": "^8.11.6",
    "@types/pg-cursor": "^2.7.2",
    "@types/node": "^22.0.0",
    "prisma": "^5.11.0",
    "typescript": "^5.6.0"
  }
}
