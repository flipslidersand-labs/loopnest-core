// Prisma schema - Master tables only (schema separation via raw SQL migrations)

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core", "workflow", "finance", "events", "audit"]
}

// Master table: Organization hierarchy
model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(255)
  type      String   @db.VarChar(50) // 'company', 'department', 'division'
  parentId  String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("organizations")
  @@schema("core")
  @@index([parentId])
}

// Master table: Customers
model Customer {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  name           String   @db.VarChar(255)
  phone          String?  @db.VarChar(20)
  address        String?  @db.Text
  organizationId String?  @map("organization_id") @db.Uuid
  creditLimit    Decimal? @map("credit_limit") @db.Decimal(15, 2)
  creditUsed     Decimal  @default(0) @map("credit_used") @db.Decimal(15, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("customers")
  @@schema("core")
  @@index([organizationId])
}

// Master table: Products
model Product {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku            String   @db.VarChar(100)
  name           String   @db.VarChar(255)
  category       String   @db.VarChar(100)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(10, 2)
  stockQuantity  Int      @default(0) @map("stock_quantity")
  organizationId String?  @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("products")
  @@schema("core")
  @@unique([sku])
  @@index([category])
  @@index([organizationId])
}

// Master table: Quotes
model Quote {
  id              String      @id @default(dbgenerated("gen_random_uuid()"))
  quoteNumber     String      @unique @map("quote_number") @db.VarChar(50)
  quoteRequestId  String?     @map("quote_request_id") @db.Uuid
  customerId      String      @map("customer_id") @db.Uuid
  subtotalAmount  Decimal?    @map("subtotal_amount") @db.Decimal(12, 2)
  taxAmount       Decimal?    @map("tax_amount") @db.Decimal(12, 2)
  totalAmount     Decimal?    @map("total_amount") @db.Decimal(12, 2)
  discountType    String?     @map("discount_type") @db.VarChar(20)
  discountValue   Decimal?    @map("discount_value") @db.Decimal(15, 4)
  discountAmount  Decimal?    @map("discount_amount") @db.Decimal(15, 2)
  status          String      @db.VarChar(50) @default("draft")
  notes           String?     @db.Text
  expiresAt       DateTime?   @map("expires_at")
  organizationId  String?     @map("organization_id") @db.Uuid
  createdBy       String      @map("created_by") @db.VarChar(255)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  quoteItems      QuoteItem[] @relation("quoteToItems")

  currency      String   @default("JPY") @db.Char(3)
  exchangeRate  Decimal  @default(1.0) @map("exchange_rate") @db.Decimal(19, 6)

  @@map("quotes")
  @@schema("core")
  @@index([customerId])
  @@index([status])
  @@index([organizationId])
}

// Master table: Quote Items
model QuoteItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId   String   @map("quote_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(10, 2)
  lineTotal Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  quote     Quote    @relation("quoteToItems", fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("quote_items")
  @@schema("core")
  @@index([quoteId])
  @@index([productId])
}

// Master table: Exchange Rates
model ExchangeRate {
  currencyCode  String   @id @map("currency_code") @db.Char(3)
  rateToJpy     Decimal  @map("rate_to_jpy") @db.Decimal(19, 6)
  effectiveDate DateTime @map("effective_date") @db.Date
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("exchange_rates")
}

// Master table: Users
model User {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  email          String   @db.VarChar(255) @unique
  name           String   @db.VarChar(255)
  nameEn         String?  @map("name_en") @db.VarChar(255)
  organizationId String   @map("organization_id") @db.Uuid
  role           String   @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("users")
  @@schema("core")
}
